---
import Terminal from '../components/Terminal';
import '../styles/global.css';
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Linux Command Trainer</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="min-h-screen bg-gradient-to-b from-gray-900 via-gray-800 to-gray-900">
    <div class="min-h-screen p-4 md:p-8">
      <header class="text-center mb-8">
        <div class="inline-block p-1 bg-gradient-to-r from-green-400 via-blue-500 to-purple-500 rounded-lg mb-4">
          <div class="bg-gray-900 rounded-md px-6 py-2">
            <h1 class="text-4xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-blue-400" style="font-family: 'Fira Code', monospace">
              Linux Command Trainer
            </h1>
          </div>
        </div>
        <p class="text-gray-400 text-lg">Aprende comandos de Linux de forma interactiva y divertida</p>
      </header>

      <main class="max-w-7xl mx-auto">
        <Terminal client:load />
      </main>

      <footer class="text-center mt-12 pb-8 text-gray-500 text-sm">
        <div class="mb-3">
          <a href="https://github.com/EDGAR-BRI/LinuxComanTrainer" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-gray-300 hover:text-white transition-colors">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
            GitHub: EDGAR-BRI/LinuxComanTrainer
          </a>
        </div>
        <p>¿Quieres agregar algo nuevo o ayudar a mejorar la página? <a href="https://github.com/EDGAR-BRI/LinuxComanTrainer/pulls" target="_blank" rel="noopener noreferrer" class="text-green-400 hover:text-green-300 hover:underline transition-colors">Abre un Pull Request</a>, ¡toda contribución es bienvenida!</p>
        <p class="mt-2">Simulador de terminal Linux | Desarrollado con Astro + React + Tailwind + GSAP</p>
      </footer>
    </div>
  </body>
</html>
